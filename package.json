{
  "name": "pw-match-downloader",
  "version": "0.2.0",
  "private": true,
  "description": "本地扫码下载完美电竞 CS2 国服官匹与完美平台原始比赛数据",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:ui": "vite",
    "dev": "node scripts/dev.mjs",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/server/server.js --open",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
